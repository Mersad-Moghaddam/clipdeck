# Maintainer: Mersad Moghaddam <nickmersad81@gmail.com>
pkgname=clipdeck
pkgver=0.5.0
pkgrel=1
pkgdesc="A keyboard-first clipboard manager daemon and CLI for X11 and compatible Wayland desktops"
arch=('x86_64' 'aarch64')
url="https://github.com/Mersad-Moghaddam/clipdeck"
license=('MIT')
depends=()
makedepends=('go' 'git')
optdepends=(
    'xclip: X11 clipboard capture and copy'
    'xdotool: X11 target activation and paste'
    'xorg-xprop: X11 window identity verification'
    'wl-clipboard: Wayland clipboard capture and copy'
    'wtype: active window direct paste simulation'
    'hyprland: Wayland compositor window focus queries'
    'fuzzel: menu selector for clipdeck pick'
    'rofi: menu selector for clipdeck pick'
    'wofi: menu selector for clipdeck pick'
)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    export CGO_ENABLED=0
    go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o bin/clipdeck ./cmd/clipdeck
    go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o bin/clipdeckd ./cmd/clipdeckd
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 bin/clipdeck "$pkgdir/usr/bin/clipdeck"
    install -Dm755 bin/clipdeckd "$pkgdir/usr/bin/clipdeckd"
    install -Dm644 packaging/clipdeckd.service "$pkgdir/usr/lib/systemd/user/clipdeckd.service"
    install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    ln -s ../clipdeckd.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/clipdeckd.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
