# Maintainer: Mersad Moghaddam <nickmersad81@gmail.com>
pkgname=clipdeck
pkgver=0.2.2
pkgrel=1
pkgdesc="A keyboard-first clipboard manager daemon and CLI for Omarchy 4 and Wayland"
arch=('x86_64' 'aarch64')
url="https://github.com/Mersad-Moghaddam/clipdeck"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
optdepends=(
    'wl-clipboard: Wayland clipboard capture and copy'
    'wtype: active window direct paste simulation'
    'hyprland: Wayland compositor window focus queries'
)
source=("$pkgname::git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    export CGO_ENABLED=0
    export GOPROXY="https://goproxy.io,direct"
    go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o bin/clipdeck ./cmd/clipdeck
    go build -trimpath -ldflags "-s -w -X main.version=$pkgver" -o bin/clipdeckd ./cmd/clipdeckd
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 bin/clipdeck "$pkgdir/usr/bin/clipdeck"
    install -Dm755 bin/clipdeckd "$pkgdir/usr/bin/clipdeckd"
    install -Dm644 packaging/clipdeckd.service "$pkgdir/usr/lib/systemd/user/clipdeckd.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
