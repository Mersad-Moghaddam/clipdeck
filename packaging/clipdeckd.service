[Unit]
Description=ClipDeck Clipboard History Daemon
Documentation=https://github.com/Mersad-Moghaddam/clipdeck
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/clipdeckd
Restart=always
RestartSec=1s
StandardOutput=journal
StandardError=journal

RuntimeDirectory=clipdeck
RuntimeDirectoryMode=0700
StateDirectory=clipdeck
StateDirectoryMode=0700
ConfigurationDirectory=clipdeck
ConfigurationDirectoryMode=0700

[Install]
WantedBy=graphical-session.target
